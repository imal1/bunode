    "%lld Services are running. Bunode stops every Run before it quits, so it never leaves processes behind.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Service is running. Bunode stops every Run before it quits, so it never leaves processes behind."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Services are running. Bunode stops every Run before it quits, so it never leaves processes behind."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个服务正在运行。Bunode 退出前会停止所有运行，不会留下进程。"
          }
        }
      }
    },
