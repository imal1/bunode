    "%lld Services are running. Bunode stops every Run before it quits, so it never leaves processes behind.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
